{
  "name": "04 · Aprovar e agendar (revisão visual, Telegram, fila)",
  "nodes": [
    {
      "parameters": {
        "jsCode": "// Junta tudo antes da prévia: qual motor foi usado de fato e se a peça passa pelo revisor visual.\nconst p = $('Receber peça pronta').first().json;\nconst veoOk = !!p.veo_ok;\nlet motor = p.motor;\nif (p.tipo === 'reel') motor = veoOk ? 'veo' : 'animacao';\nconst veo_falhou = p.motor === 'veo' && !veoOk;\nconst revisao = p.rota === 'feed-foto' ? 'imagem' : (veoOk ? 'video' : 'nenhuma');\nconst veoUsados = p.veo_no_mes + (veoOk ? 1 : 0);\nreturn [{ json: { ...p, motor, revisao, veo_falhou, veo_no_mes: veoUsados, eh_video: p.tipo === 'reel' } }];\n"
      },
