      "parameters": {
        "jsCode": "// Lê o parecer do revisor visual (Gemini olhando a peça final).\nconst p = $('Preparar prévia').first().json;\nconst resp = $input.first().json || {};\nconst texto = (resp.content?.parts || []).map((x) => x.text || '').join('\\n') || JSON.stringify(resp);\nlet parecer = { aprovado: true, problemas: [] };\ntry {\n  const bruto = texto.replace(/```(json)?/g, '').trim();\n  const ini = bruto.indexOf('{'), fim = bruto.lastIndexOf('}');\n  parecer = JSON.parse(bruto.slice(ini, fim + 1));\n} catch (e) {\n  parecer = { aprovado: false, problemas: ['Não consegui ler o parecer do revisor visual: confira a peça com atenção.'] };\n}\nconst problemas = Array.isArray(parecer.problemas) ? parecer.problemas : [];\nreturn [{ json: { ...p, visual_aprovado: parecer.aprovado === true, visual_nota: parecer.aprovado === true\n  ? '✅ Revisor visual: sem problemas.'\n  : `⚠️ Revisor visual: ${problemas.join('; ') || 'reprovou sem detalhar'}` } }];\n"
      },
