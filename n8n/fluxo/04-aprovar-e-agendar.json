    {
      "parameters": {
        "jsCode": "// Próximo horário de postagem da marca (feed ou Reels), a partir da data planejada e nunca no passado.\nconst p = $('Preparar prévia').first().json;\nconst m = p.marca;\nconst dias = p.tipo === 'reel' ? [m.reel_dia] : m.dias_postagem;\nconst [h, min] = (p.tipo === 'reel' ? m.horario_reel : m.horario).split(':').map(Number);\nconst agora = $now.setZone(m.geral.fuso);\n\nlet dia = DateTime.fromISO(m.data_postagem, { zone: m.geral.fuso }).set({ hour: h, minute: min, second: 0, millisecond: 0 });\nfor (let i = 0; i < 21; i++) {\n  if (dias.includes(dia.weekday) && dia > agora.plus({ minutes: 5 })) break;\n  dia = dia.plus({ days: 1 });\n}\nreturn [{ json: { ...p, agendado_para: dia.toISO(), agendado_legivel: dia.setLocale('pt-BR').toFormat(\"cccc, dd/LL 'às' HH:mm\") } }];\n"
      },
