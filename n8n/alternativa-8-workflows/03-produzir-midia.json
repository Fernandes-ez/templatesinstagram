    {
      "parameters": {
        "jsCode": "// Junta a peça com o que aconteceu aqui (o Veo foi gerado? o render do Veo deu certo? as lâminas do carrossel) para o workflow 04.\nconst p = $('Receber peça').first().json;\nconst car = $('Juntar lâminas').isExecuted ? $('Juntar lâminas').first().json : null;\nconst midia = car ? { midia_url: car.midia_url, midia_urls: car.midia_urls } : { midia_urls: [p.midia_url] };\nreturn [{ json: { ...p, ...midia, veo_gerado: $('Gerar vídeo (Veo)').isExecuted, veo_ok: $('Renderizar Reels (Veo)').isExecuted } }];\n"
      },
      "id": "48b71202-cc67-4b36-a259-1d6d1986f7ac",
      "name": "Fechar etapa de mídia",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1700,
        1800
      ]
    },
    {
      "parameters": {
        "jsCode": "// Você recusou o roteiro do Veo (nenhum crédito gasto): monta o registro e segue para o workflow 05.\nconst p = $('Receber peça').first().json;\nreturn [{ json: {\n  marca: p.marca.marca_id, nome_marca: p.marca.nome, telegram_chat_id: p.marca.geral.telegram_chat_id,\n  tipo: p.tipo, modelo: '', motor: 'nenhum', pilar: p.pilar, tema: p.tema, legenda: p.legenda, midia_url: '',\n  nota_revisao: Number(p.nota_revisao) || 0, status: 'reprovado',\n  erro: 'Roteiro do Veo recusado por você (nenhum crédito gasto).',\n} }];\n"
      },
      "id": "a13e8406-b357-4eda-9a9a-f9bc8c23cdcb",
      "name": "Montar reprovação (roteiro do Veo)",
      "type": "n8n-nodes-base.code",
